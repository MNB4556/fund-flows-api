{
  "name": "fund-flows-api",
  "version": "0.1.0",
  "private": true,
  "description": "A small TypeScript and PostgreSQL service for fund flows, client summaries and monthly reconciliation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:setup": "tsx src/db/setup.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
