# Copy to .env and fill in. Never commit .env.
#
# Neon hands out postgresql:// URLs. Keep ?sslmode=require on the end, or the
# connection is refused.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. The tests truncate every table, so they run against a separate
# database whose name ends in _test.
# DATABASE_URL_TEST=postgresql://user:password@host/fund_flows_test?sslmode=require

# Optional. Defaults to 5. A free Neon database allows a small number of
# connections, so keep this low.
# PGPOOL_MAX=5
